---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import StickyNavbar from "../components/StickyNavbar.astro";
import Footer from "../components/Footer.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/dennisavatar.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Delicious+Handrawn&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />

    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Delicious+Handrawn&display=swap" />
    </noscript>

    <title>Dennis Abrams - Portfolio</title>

    <!-- Font loading optimization script -->
    <script>
      if (!document.querySelector('link[href*="fonts.googleapis.com"][rel="stylesheet"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Delicious+Handrawn&display=swap';
        document.head.appendChild(link);
      }
    </script>
  </head>
  <body class="bg-black text-white">
    <StickyNavbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ClientRouter />
  </body>
</html>